# Supabase — get these from https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Admin secret for posting jobs via API (make this a long random string)
ADMIN_SECRET=your_admin_secret_here

# Optional: Vercel redeploy webhook (from Vercel → Settings → Git → Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=your_vercel_deploy_hook_url_here
